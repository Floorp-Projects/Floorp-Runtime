+fn transform_brand(s: &str) -> Cow<'_, str> {
+    if s.contains("Firefox") || s.contains("Mozilla") {
+        Cow::Owned(s.replace("Firefox", "Floorp").replace("Mozilla", "Ablaze"))
+    } else {
+        Cow::Borrowed(s)
+    }
+}
