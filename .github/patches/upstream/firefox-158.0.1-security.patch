# Firefox 158.0.1 security backport; requires freshly compiled Runtime binaries.
# SVG: Mozilla commit 0821388deee6fad0f9adf5c4c83b36244391be5b (bug 2079938).
# OneCRL: exact dump from 9378fbc58660847fbc02c3486a0ecd6049978e25.
# Validate against Runtime 7dd619742b25567e479eeda97ae071d10542ad0b.
diff --git a/layout/base/nsCSSFrameConstructor.cpp b/layout/base/nsCSSFrameConstructor.cpp
--- a/layout/base/nsCSSFrameConstructor.cpp
+++ b/layout/base/nsCSSFrameConstructor.cpp
@@ -4977,12 +4977,13 @@ nsCSSFrameConstructor::FindElementData(const Element& aElement,
                                        ItemFlags aFlags) {
   // Don't create frames for non-SVG element children of SVG elements.
   if (!aElement.IsSVGElement()) {
-    // NOTE: Anon content is allowed, the native code should know what it's
-    // doing. In practice we care about ::backdrop and the
-    // custom-content-container.
+    // NOTE: Anon content (from non display: contents) is allowed, the native
+    // code should know what it's doing. In practice we care about ::backdrop
+    // and the custom-content-container.
     if (aParentFrame && IsFrameForSVG(aParentFrame) &&
         !aParentFrame->IsSVGForeignObjectFrame() &&
-        !aElement.IsRootOfNativeAnonymousSubtree()) {
+        (aElement.GetParent() != aParentFrame->GetContent() ||
+         !aElement.IsRootOfNativeAnonymousSubtree())) {
       return nullptr;
     }
     if (aFlags.contains(ItemFlag::IsWithinSVGText)) {
diff --git a/testing/web-platform/tests/css/css-display/display-contents-svg-pseudo-crash.html b/testing/web-platform/tests/css/css-display/display-contents-svg-pseudo-crash.html
new file mode 100644
--- /dev/null
+++ b/testing/web-platform/tests/css/css-display/display-contents-svg-pseudo-crash.html
@@ -0,0 +1,19 @@
+<!DOCTYPE html>
+<style>
+g { display: contents; }
+g::before { content: "cap"; display: table-caption; }
+</style>
+<svg id=root width=300 height=300><g id=g></g></svg>
+<script>
+onload = () => {
+  document.documentElement.offsetWidth;
+  let r = document.createElementNS("http://www.w3.org/2000/svg", "rect");
+  r.setAttribute("width", 100);
+  r.setAttribute("height", 100);
+  r.style.filter = "blur(2px)";
+  g.appendChild(r);
+  document.documentElement.offsetWidth;
+  root.style.textShadow = "2px 2px red";
+  document.documentElement.offsetWidth;
+};
+</script>
