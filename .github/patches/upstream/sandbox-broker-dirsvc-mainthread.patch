@@ -82,6 +82,49 @@ static const int deny = SandboxBroker::FORCE_DENY;
 using CacheE = std::pair<nsCString, int>;
 using FileCacheT = nsTArray<CacheE>;
 
+// dirsvc (and therefore NS_GetSpecialDirectory) may only be used on the
+// main thread, but the policies below are built on process-spawn threads.
+// The needed paths are resolved once on the main thread, when the factory
+// is created, and reused afterwards.
+static StaticMutex sSpecialDirMutex;
+static char sGreDirPath[4096];
+static char sProfileDirPath[4096];
+
+static void CachePath(nsIFile* aDir, char* aOut, size_t aOutSize) {
+  nsAutoCString path;
+  if (NS_SUCCEEDED(aDir->GetNativePath(path)) && path.Length() < aOutSize) {
+    memcpy(aOut, path.get(), path.Length() + 1);
+  }
+}
+
+static void CacheSpecialDirectories() {
+  MOZ_ASSERT(NS_IsMainThread());
+  nsCOMPtr<nsIFile> dir;
+  if (NS_SUCCEEDED(NS_GetSpecialDirectory(NS_GRE_DIR, getter_AddRefs(dir)))) {
+    CachePath(dir, sGreDirPath, sizeof(sGreDirPath));
+  }
+  if (NS_SUCCEEDED(NS_GetSpecialDirectory(NS_APP_USER_PROFILE_50_DIR,
+                                          getter_AddRefs(dir)))) {
+    CachePath(dir, sProfileDirPath, sizeof(sProfileDirPath));
+  }
+}
+
+static nsCString GreDirPath() {
+  StaticMutexAutoLock lock(sSpecialDirMutex);
+  if (sGreDirPath[0] == '\0' && NS_IsMainThread()) {
+    CacheSpecialDirectories();
+  }
+  return nsCString(sGreDirPath);
+}
+
+static nsCString ProfileDirPath() {
+  StaticMutexAutoLock lock(sSpecialDirMutex);
+  if (sProfileDirPath[0] == '\0' && NS_IsMainThread()) {
+    CacheSpecialDirectories();
+  }
+  return nsCString(sProfileDirPath);
+}
